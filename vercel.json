{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(upsell|upsell-.*|downsell|downsell-.*|upsell_kit_pro)",
      "destination": "/entrega-completo",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/electromapas-pro-app", "destination": "/app/index.html" },
    { "source": "/electromapas-pro-app.html", "destination": "/app/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" },
    { "source": "/tailwind.min.js", "destination": "/app/tailwind.min.js" },
    { "source": "/manifest.json", "destination": "/app/manifest.json" },
    { "source": "/sw.js", "destination": "/app/sw.js" }
  ],
  "headers": [
    {
      "source": "/(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|index\\.html|entrega-completo)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
