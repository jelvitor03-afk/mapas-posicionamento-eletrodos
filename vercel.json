{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|index\\.html|upsell\\.html|upsell|entrega-completo|entrega-pro)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|jpg|jpeg|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
